{
  "schema_version": 1,
  "checked_on": "2026-09-19",
  "source": {
    "repository": "https://github.com/dmort27/epitran",
    "note": "Language/script support verified against the official Epitran README and tests. Epitran availability is a feasibility signal, not a pronunciation-quality guarantee."
  },
  "rules": {
    "no_silent_fallback": true,
    "emit_raw_lexical_forms_publicly": false,
    "special_dependency_failure_status": "BLOCKED_BY_DEPENDENCY",
    "transliteration_empty_status": "EMPTY_OR_UNSUPPORTED",
    "multiword_policy": "audit separately; do not assume tokenwise composition is phonologically valid",
    "code_switching_policy": "flag for manual/language-aware review"
  },
  "languages": [
    {
      "language": "Yue Chinese",
      "samples": [
        "Cantonese (CN)"
      ],
      "iso639_3": "yue",
      "primary_backend": "Epitran",
      "primary_code": "yue-Hant",
      "alternate_code": "yue-Latn",
      "script": "Hant",
      "dependency": "CC-Canto",
      "dependency_required": true,
      "caveat": "Official Epitran README warns character G2P requires CC-Canto and single characters may have multiple pronunciations."
    },
    {
      "language": "Dutch",
      "samples": [
        "Dutch (BE)"
      ],
      "iso639_3": "nld",
      "primary_backend": "Epitran",
      "primary_code": "nld-Latn",
      "script": "Latn",
      "dependency_required": false
    },
    {
      "language": "English",
      "samples": [
        "English (AU)",
        "English (CA)",
        "English (GB)",
        "English (SG)",
        "English (US)"
      ],
      "iso639_3": "eng",
      "primary_backend": "Epitran",
      "primary_code": "eng-Latn",
      "script": "Latn",
      "dependency": "Flite + lex_lookup",
      "dependency_required": true,
      "caveat": "Official Epitran README states English IPA requires Flite including lex_lookup; dialectal pronunciation is not represented by a single generic backend."
    },
