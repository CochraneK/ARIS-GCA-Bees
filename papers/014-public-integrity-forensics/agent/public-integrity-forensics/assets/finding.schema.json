{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CochraneK/ARIS4C/papers/014-public-integrity-forensics/agent/public-integrity-forensics/assets/finding.schema.json",
  "title": "Public Integrity Forensics Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "subject_id",
    "detector_id",
    "detector_version",
    "family",
    "applicable",
    "applicability_reason",
    "status",
    "evidence_class",
    "claim",
    "evidence",
    "source_refs",
    "dependency_group",
    "reproducible",
    "benign_explanations",
    "corruption_inference"
  ],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "detector_id": {"type": "string", "minLength": 1},
    "detector_version": {"type": "string", "minLength": 1},
    "family": {
      "type": "string",
      "enum": [
        "procurement_process",
        "value_threshold",
        "supplier_concentration",
        "temporal_forensics",
        "corporate_ownership",
        "conflict_of_interest",
        "sanctions_debarment",
        "identity_provenance",
        "document_coordination",
        "graph_network",
        "weak_heuristics"
      ]
    },
    "applicable": {"type": "boolean"},
    "applicability_reason": {"type": "string"},
    "status": {"type": "string", "enum": ["FLAG", "PASS", "ABSTAIN", "ERROR"]},
    "evidence_class": {"type": "string", "enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
    "claim": {"type": "string"},
    "evidence": {"type": "object"},
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_name", "record_id"],
        "properties": {
          "source_name": {"type": "string"},
          "record_id": {"type": "string"},
          "url": {"type": "string"},
          "published_at": {"type": ["string", "null"]},
          "retrieved_at": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "dependency_group": {"type": "string"},
    "observed_at": {"type": ["string", "null"]},
    "reproducible": {"type": "string", "enum": ["yes", "no", "unknown"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "calibration_reference": {"type": ["string", "null"]},
    "benign_explanations": {"type": "array", "items": {"type": "string"}},
    "corruption_inference": {"const": false}
  }
}
