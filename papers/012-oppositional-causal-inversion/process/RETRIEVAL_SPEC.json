{
  "protocol_version": "0.2.0",
  "frozen_date": "2026-09-18",
  "amendment_reason": "v0.1 proved reproducible but showed lexical/semantic contamination. v0.2 adds outcome-independent record-type and title-anchor relevance gates before screening.",
  "purpose": "Reproducible retrieval stress test for ARIS4C012 Gate R. Results are candidate records, not OCI-positive labels.",
  "providers": {
    "openalex": {
      "endpoint": "https://api.openalex.org/works",
      "rows_per_query": 50,
      "sort": "relevance_score:desc",
      "allowed_types": [
        "article",
        "book-chapter",
        "preprint",
        "book",
        "report",
        "dissertation"
      ],
      "select": [
        "id",
        "doi",
        "display_name",
        "publication_year",
        "type",
        "cited_by_count",
        "primary_topic",
        "ids"
      ]
    },
    "crossref": {
      "endpoint": "https://api.crossref.org/works",
      "rows_per_query": 50,
      "allowed_types": [
        "journal-article",
        "book-chapter",
        "proceedings-article",
        "posted-content",
        "book",
        "monograph",
        "report",
        "dissertation"
      ],
      "select": [
        "DOI",
        "title",
        "published",
        "type",
        "container-title",
        "URL",
        "is-referenced-by-count"
      ]
    }
  },
  "selection": {
    "merge_rule": "interleave_by_source_rank_openalex_then_crossref_after_type_and_title_anchor_gates",
    "dedupe_rule": "normalized DOI, otherwise normalized title + publication year",
    "selected_per_stratum": 30,
    "no_random_sampling": true,
    "no_post_retrieval_outcome_reranking": true,
    "topical_gate": "Every anchor group must contribute at least one phrase present in the normalized title."
  },
  "strata": [
