{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CochraneK/ARIS4C/papers/010-universal-concept-identification/data/ucid-response.schema.json",
  "title": "UCID target-query response record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_id",
    "query_id",
    "protocol",
    "answer",
    "oracle_type",
    "provenance"
  ],
  "properties": {
    "target_id": {"type": "string", "minLength": 1},
    "query_id": {"type": "string", "minLength": 1},
    "protocol": {"enum": ["P2", "P6", "P6_CONTEXT"]},
    "answer": {
      "enum": [
        "YES",
        "NO",
        "BORDERLINE",
        "UNKNOWN",
        "UNDEFINED",
        "BOTH",
        "CONTEXT_REQUEST"
      ]
    },
    "oracle_type": {
      "enum": [
        "human",
        "lexical_resource",
        "knowledge_base",
        "llm",
        "formal_solver",
        "adjudicated_consensus",
        "other"
      ]
    },
    "oracle_id": {"type": ["string", "null"]},
    "repeat_index": {"type": "integer", "minimum": 0, "default": 0},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "context_payload": {"type": ["object", "null"]},
    "justification": {"type": ["string", "null"]},
    "provenance": {
      "type": "object",
      "required": ["source_type"],
      "properties": {
        "source_type": {
          "enum": [
            "direct_annotation",
            "resource_lookup",
            "formal_derivation",
            "model_generation",
            "adjudication",
            "other"
          ]
        },
        "source": {"type": ["string", "null"]},
        "timestamp": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"protocol": {"const": "P2"}}},
      "then": {"properties": {"answer": {"enum": ["YES", "NO"]}}}
    }
  ]
}
